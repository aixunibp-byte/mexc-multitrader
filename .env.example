APP_NAME=MEXC MultiTrader
DATABASE_URL=sqlite:////data/mexc_multitrader.db

FERNET_KEY=PUT_A_GENERATED_FERNET_KEY_HERE
ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN

# Keep false until a full dry-run and operational review are complete.
LIVE_TRADING=false
MAX_LEVERAGE=3
MAX_ORDER_VOL=10
ALLOWED_SYMBOLS=BTC_USDT,ETH_USDT,SOL_USDT

# Risk controls. Set MAX_DAILY_LOSS_USDT=0 to disable the loss limit.
MAX_DAILY_LOSS_USDT=50
BLOCK_IF_POSITION_OPEN=true
ALLOW_DRY_RUN_WHEN_KILL_SWITCHED=true

# Startup / health verification.
RUN_STARTUP_SELF_CHECK=true
MAX_CLOCK_DRIFT_MS=5000
MEXC_CHECK_CONCURRENCY=5
SYSTEM_CHECK_MAX_AGE_SECONDS=300

# New-listing discovery. The service polls each exchange's public contract
# list on this interval and records any symbol it has not seen before as a
# NEW_LISTING risk event. AUTO_ALLOW_NEW_LISTINGS=false (default) means a
# freshly discovered symbol is only tradeable after an operator approves it
# via PATCH /api/symbols/{id}/allow; set it to true to make newly listed
# contracts tradeable immediately, without manual review.
SYMBOL_SYNC_INTERVAL_SECONDS=300
AUTO_ALLOW_NEW_LISTINGS=false

MEXC_BASE_URL=https://contract.mexc.com
GATE_BASE_URL=https://api.gateio.ws/api/v4
REQUEST_TIMEOUT_SECONDS=15
