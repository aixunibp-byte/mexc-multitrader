APP_NAME=MEXC MultiTrader
DATABASE_URL=sqlite:////data/mexc_multitrader.db

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=PUT_A_GENERATED_FERNET_KEY_HERE
ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN

# Keep disabled until API access and balance reads have been verified.
LIVE_TRADING=false

MAX_LEVERAGE=10
MAX_ORDER_VOL=1000
ALLOWED_SYMBOLS=BTC_USDT,ETH_USDT,SOL_USDT

MEXC_BASE_URL=https://api.mexc.com
REQUEST_TIMEOUT_SECONDS=15
